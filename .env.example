# Copie para .env (local) ou cadastre na Vercel: Settings → Environment Variables.
# Use SOMENTE a chave publicável (sb_publishable_...). Nunca a secret/service_role.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Opcional: restringe o cadastro a domínios de e-mail (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=
